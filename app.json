{
  "expo": {
    "name": "PRAXIS",
    "slug": "myApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "praxis",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.nathanexpo.myApp"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "tsconfigPaths": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "25e72824-8d64-45be-bd48-abb278859782"
      }
    },
    "owner": "nathan-expo"
  }
}
